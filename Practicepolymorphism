
#include <iostream>
#include <string>
using namespace std;

class Employee {
private:
    int cccd;
    string name;
    double salary;

public:
    Employee() {
        cccd = 0;
        name = "";
        salary = 0;
    }

    Employee(int c, string n, double s) {
        cccd = c;
        name = n;
        salary = s;
    }

    virtual ~Employee() {}

    int getCCCD() const {
        return cccd;
    }

    string getName() const {
        return name;
    }

    double getSalary() const {
        return salary;
    }

    void setCCCD(int c) {
        cccd = c;
    }

    void setName(string n) {
        name = n;
    }

    void setSalary(double s) {
        salary = s;
    }

    virtual double calculateSalary(int month, int year) const {
        return 0;
    }

    virtual double calculateYearlySalary(int year) const {
        double total = 0;

        for (int month = 1; month <= 12; month++) {
            total += calculateSalary(month, year);
        }

        return total;
    }

    virtual void displayInfo() const {
        cout << "CCCD: " << cccd << endl;
        cout << "Name: " << name << endl;
    }
};

class HourlyEmployee : public Employee {
private:
    int hours, month, year;
    double salaryperhours;

public:
    HourlyEmployee() : Employee() {
        hours = 0;
        salaryperhours = 0;
        month = 1;
        year = 2026;
    }

    HourlyEmployee(int c, string n, int h, double rate, int m, int y) : Employee(c, n, 0) {
        hours = h;
        salaryperhours = rate;
        month = m;
        year = y;
    }

    int getHours() const {
        return hours;
    }

    double getSalaryPerHours() const {
        return salaryperhours;
    }

    int getMonth() const {
        return month;
    }

    int getYear() const {
        return year;
    }

    void setHours(int h) {
        hours = h;
    }

    void setSalaryPerHours(double rate) {
        salaryperhours = rate;
    }

    void setMonth(int m) {
        month = m;
    }

    void setYear(int y) {
        year = y;
    }

    double calculateSalary(int m, int y) const override {
        if (m == month && y == year)
            return hours * salaryperhours;

        return 0;
    }

    double calculateYearlySalary(int y) const override {
        if (y == year)
            return calculateSalary(month, year) * 12;

        return 0;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << "Hours: " << hours << endl;
        cout << "Salary per hour: " << salaryperhours << endl;
        cout << "Month: " << month << endl;
        cout << "Year: " << year << endl;
        cout << "Salary: " << calculateSalary(month, year) << endl;
    }
};

class MonthlyEmployee : public Employee {
private:
    int month, year;

public:
    MonthlyEmployee() : Employee() {
        month = 1;
        year = 2026;
    }

    MonthlyEmployee(int c, string n, double monthlySalary, int m, int y) : Employee(c, n, monthlySalary) {
        month = m;
        year = y;
    }

    int getMonth() const {
        return month;
    }

    int getYear() const {
        return year;
    }

    void setMonth(int m) {
        month = m;
    }

    void setYear(int y) {
        year = y;
    }

    double calculateSalary(int m, int y) const override {
        if (m == month && y == year)
            return getSalary();

        return 0;
    }

    double calculateYearlySalary(int y) const override {
        if (y == year)
            return getSalary() * 12;

        return 0;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << "Monthly salary: " << getSalary() << endl;
        cout << "Month: " << month << endl;
        cout << "Year: " << year << endl;
        cout << "Salary: " << calculateSalary(month, year) << endl;
    }
};

class DailyEmployee : public Employee {
private:
    int numberofdays, month, year;

public:
    DailyEmployee() : Employee() {
        numberofdays = 0;
        month = 1;
        year = 2026;
    }

    DailyEmployee(int c, string n, double salaryPerDay, int days, int m, int y) : Employee(c, n, salaryPerDay) {
        numberofdays = days;
        month = m;
        year = y;
    }

    int getNumberOfDays() const {
        return numberofdays;
    }

    int getMonth() const {
        return month;
    }

    int getYear() const {
        return year;
    }

    void setNumberOfDays(int days) {
        numberofdays = days;
    }

    void setMonth(int m) {
        month = m;
    }

    void setYear(int y) {
        year = y;
    }

    double calculateSalary(int m, int y) const override {
        if (m == month && y == year)
            return numberofdays * getSalary();

        return 0;
    }

    double calculateYearlySalary(int y) const override {
        if (y == year)
            return calculateSalary(month, year) * 12;

        return 0;
    }

    void displayInfo() const override {
        Employee::displayInfo();
        cout << "Number of days: " << numberofdays << endl;
        cout << "Salary per day: " << getSalary() << endl;
        cout << "Month: " << month << endl;
        cout << "Year: " << year << endl;
        cout << "Salary: " << calculateSalary(month, year) << endl;
    }
};

int main() {
    HourlyEmployee h(1, "An", 160, 50000, 10, 2026);
    MonthlyEmployee m(2, "Binh", 15000000, 10, 2026);
    DailyEmployee d(3, "Chi", 300000, 22, 10, 2026);

    Employee* employees[] = {&h, &m, &d};


    for (Employee* e : employees) {
        e->displayInfo();
    }

    int month, year;

    cout << "\nEnter month (1-12): ";
    cin >> month;

    cout << "Enter year: ";
    cin >> year;

    if (month < 1 || month > 12) {
        cout << "Invalid month!\n";
        return 0;
    }

    double totalSalary = 0;


    for (Employee* e : employees) {
        double salary = e->calculateSalary(month, year);

        cout << e->getName() << ": " << salary << endl;
        totalSalary += salary;
    }

    cout << "Total salary: " << totalSalary << endl;


    for (Employee* e : employees) {
        cout << e->getName() << ": "
             << e->calculateYearlySalary(year) << endl;
    }

    return 0;
}
