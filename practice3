
#include <iostream>
#include <string>
using namespace std;

class Drink {
protected:
    string id, name;
    int quantity, day, month, year;
    double price;

public:
    Drink() {
        id = name = "";
        quantity = day = month = year = 0;
        price = 0;
    }

    virtual void input() {
        cout << "Enter product ID: ";
        cin >> id;
        cout << "Enter product name: ";
        cin >> name;
        cout << "Enter quantity sold: ";
        cin >> quantity;
        cout << "Enter unit price: ";
        cin >> price;
        cout << "Enter sale date: ";
        cin >> day >> month >> year;
    }

    bool isSameDate(int d, int m, int y) {
        return day == d && month == m && year == y;
    }

    virtual double calculateRevenue(int d, int m, int y) = 0;

    virtual ~Drink() {}
};

class Coffee : public Drink {
public:
    double calculateRevenue(int d, int m, int y) override {
        if (isSameDate(d, m, y))
            return quantity * price;
        return 0;
    }
};

