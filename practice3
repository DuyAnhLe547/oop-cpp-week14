double calculateDrinksRevenue(
    Drink* drinks[], int size, int d, int m, int y) {
    double total = 0;

    for (int i = 0; i < size; i++)
        total += drinks[i]->calculateRevenue(d, m, y);

    return total;
}

double calculateFoodsRevenue(
    Food* foods[], int size, int d, int m, int y) {
    double total = 0;

    for (int i = 0; i < size; i++)
        total += foods[i]->calculateRevenue(d, m, y);

    return total;
}

int main() {
    Drink* drinks[100];
    Food* foods[100];

    int drinkCount, foodCount;

    cout << "Enter number of drink products: ";
    cin >> drinkCount;

    if (drinkCount < 0 || drinkCount > 100) {
        cout << "Invalid number of products\n";
        return 0;
    }

    for (int i = 0; i < drinkCount; i++) {
        int type;

        cout << "\nChoose drink type "
             << "(1-Coffee, 2-Tea, 3-Smoothie, 4-Juice): ";
        cin >> type;

        switch (type) {
            case 1: drinks[i] = new Coffee(); break;
            case 2: drinks[i] = new Tea(); break;
            case 3: drinks[i] = new Smoothie(); break;
            case 4: drinks[i] = new Juice(); break;
            default:
                cout << "Invalid drink type\n";
                for (int j = 0; j < i; j++)
                    delete drinks[j];
                return 0;
        }

        drinks[i]->input();

        if (cin.fail()) {
            cout << "Invalid input!\n";
            for (int j = 0; j <= i; j++)
                delete drinks[j];
            return 0;
        }
    }

    cout << "\nEnter number of food products: ";
    cin >> foodCount;

    if (foodCount < 0 || foodCount > 100) {
        cout << "Invalid number of products!\n";
        for (int i = 0; i < drinkCount; i++)
            delete drinks[i];
        return 0;
    }

    for (int i = 0; i < foodCount; i++) {
        int type;

        cout << "\nChoose food type (1-Cake, 2-Bread): ";
        cin >> type;

        switch (type) {
            case 1: foods[i] = new Cake(); break;
            case 2: foods[i] = new Bread(); break;
            default:
                cout << "Invalid food type!\n";

                for (int j = 0; j < drinkCount; j++)
                    delete drinks[j];
                for (int j = 0; j < i; j++)
                    delete foods[j];

                return 0;
        }

        foods[i]->input();

        if (cin.fail()) {
            cout << "Invalid input!\n";

            for (int j = 0; j < drinkCount; j++)
                delete drinks[j];
            for (int j = 0; j <= i; j++)
                delete foods[j];

            return 0;
        }
    }

    int d, m, y;

    cout << "\nEnter date to search (dd mm yyyy): ";
    cin >> d >> m >> y;

    double drinkRevenue =
        calculateDrinksRevenue(drinks, drinkCount, d, m, y);

    double foodRevenue =
        calculateFoodsRevenue(foods, foodCount, d, m, y);

    cout << "Date: " << d << "/" << m << "/" << y << endl;
    cout << "Drinks revenue: " << drinkRevenue << " VND\n";
    cout << "Foods revenue: " << foodRevenue << " VND\n";
    cout << "Total revenue: " << drinkRevenue + foodRevenue << " VND\n";

    for (int i = 0; i < drinkCount; i++)
        delete drinks[i];

    for (int i = 0; i < foodCount; i++)
        delete foods[i];

    return 0;
}
